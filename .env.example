# =======================================================
# e& Egypt Agentic Knowledge Base - Configuration
# =======================================================

# Cloud LLM provider (Azure OpenAI / OpenAI-compatible). Required for the
# "cloud" model option in the frontend; if unset, requests silently fall
# back to the local model below.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Local LLM (Ollama) — used when the frontend's model toggle is set to
# "local", or as an automatic fallback if LLM_API_KEY is missing.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=ollama
# A small GPU (e.g. 4GB VRAM) can only serve one generation at a time.
LOCAL_LLM_MAX_CONCURRENT=1

# Embedding model (local CPU execution via sentence-transformers). Must be a
# multilingual model — this assistant answers Arabic and English, and an
# English-only model badly degrades Arabic semantic retrieval.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector store
CHROMA_PATH=./chroma_db
COLLECTION_NAME=etisalat_knowledge

# Retrieval
TOP_K=15
FINAL_K=5
CROSS_ENCODER_RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=20

# Security & API limits
MAX_QUERY_LENGTH=2000
MAX_HISTORY_MESSAGES=20
RATE_LIMIT_PER_MINUTE=20
# Explicit allowlist — NOT "*" for a real deployment (the API sets
# allow_credentials=True, which browsers reject when combined with a
# wildcard origin anyway). Set this to your real frontend domain(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Conversation memory
PERSISTENT_MEMORY_ENABLED=true
MEMORY_DB_PATH=./memory.db

# Answer validation repair loop
MAX_GENERATION_REPAIRS=1

# Signs server-issued conversation IDs (app/memory/session_id.py) so a client
# can't forge/guess another session's ID. Set explicitly for any multi-worker
# or multi-restart deployment — auto-generated per-process otherwise (dev only).
SESSION_SECRET=
