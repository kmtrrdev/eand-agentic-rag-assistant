# =======================================================
# e& Egypt Agentic Knowledge Base - Configuration
# Hardware Profile: Lenovo Legion Slim 5i (RTX 4050 4GB / 16GB RAM)
# =======================================================

# Cloud LLM Provider Configuration (Optional)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local LLM Configuration (Ollama / RTX 4050 4GB)
# Profiles:
#   SAFE:    qwen2.5:3b (default: fits 100% in 4GB VRAM, ~70+ tok/s)
#   QUALITY: qwen2.5:7b (GPU+CPU offload, higher reasoning)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=ollama
LLM_MAX_CONCURRENT_REQUESTS=1

# Embedding Model Configuration (Local CPU execution via sentence-transformers)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Store Configuration
CHROMA_PATH=./chroma_db
COLLECTION_NAME=etisalat_knowledge

# Ingestion & Chunking Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# Retrieval & Evaluation Parameters
TOP_K=8
FINAL_K=5
MAX_RETRIES=1

# Security & API Parameters
MAX_QUERY_LENGTH=2000
MAX_HISTORY_MESSAGES=20
CORS_ORIGINS=*

# Feature Flags
PERSISTENT_MEMORY_ENABLED=true
MEMORY_DB_PATH=./memory.db
CHUNKING_STRATEGY=smart
CROSS_ENCODER_RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=20
MCP_ENABLED=true

# Signs server-issued conversation IDs (app/memory/session_id.py) so a client can't
# forge/guess another session's ID. Set explicitly for any multi-worker or
# multi-restart deployment — auto-generated per-process otherwise (dev only).
SESSION_SECRET=
