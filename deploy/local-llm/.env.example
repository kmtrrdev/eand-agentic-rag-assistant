# ============================================================
# Local LLM Deployment — .env.example
# Hardware Target: Lenovo Legion Slim 5i | RTX 4050 4GB VRAM | 16GB RAM
# ============================================================

# ── Hardware Profile Selection ───────────────────────────────
# Options:
#   SAFE    -> qwen2.5:3b (default: fits 100% in 4GB VRAM, fast & stable)
#   QUALITY -> qwen2.5:7b (GPU+CPU offload, higher reasoning)
LLM_PROFILE=SAFE

# ── Ollama Server ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# Model to use. Matches official Ollama library tags:
#   qwen2.5:3b  — SAFE default (1.9 GB, ~70+ tok/s, 100% GPU VRAM)
#   qwen2.5:7b  — QUALITY mode (4.7 GB, GPU+CPU split)
OLLAMA_MODEL=qwen2.5:3b

# ── LLM Inference Parameters ──────────────────────────────────
# Context window: keep at 4096 for 4GB VRAM.
LLM_CONTEXT_LENGTH=4096

# Max output tokens. 512 is safe and sufficient for telecom answers.
LLM_MAX_TOKENS=512

# Temperature: 0.2 is recommended for factual customer support.
LLM_TEMPERATURE=0.2

# ── Resource Protection & GPU Tuning ──────────────────────────
# CRITICAL: 1 concurrent request max prevents VRAM / RAM thrashing
LLM_MAX_CONCURRENT_REQUESTS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_GPU_LAYERS=-1

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
